# Demo defaults contain no real credentials. Copy to .env only when customization is needed.
APP_ENV=demo
APP_HOST=127.0.0.1
APP_PORT=8000
TRADING_MODE=paper
DATABASE_URL=postgresql+psycopg://etf_sentinel:demo_only_change_me@postgres:5432/etf_sentinel
REDIS_URL=redis://redis:6379/0
SNAPSHOT_DIR=/app/var/snapshots
EXPORT_DIR=/app/var/exports
MARKET_DATA_PROVIDER=demo_fixture
DEMO_EVALUATION_TIME=2025-01-30T08:00:00Z
DATA_STALE_AFTER_MINUTES=2880
GLOBAL_KILL_SWITCH=false
# Wall-clock checks only; fixed Demo is never turned into real-time market data.
MONITORING_INTERVAL_HOURS=1
SINGLE_ETF_CAP=0.10
ASSET_CLASS_CAP=0.45
INDUSTRY_CAP=0.30
REGION_CAP=0.60
PORTFOLIO_VOLATILITY_TARGET=0.12
CASH_FLOOR=0.20
MAX_TURNOVER=0.25
MAX_SIMULATION_LOSS=0.10
MAX_DRAWDOWN=0.15
NEWS_RISK_REDUCTION_THRESHOLD=0.70
NEWS_FACTOR_WEIGHT_CAP=0.15
ALERT_COOLDOWN_MINUTES=240
ALERT_DAILY_LIMIT=50
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# These phase-one boundaries must remain false. Startup fails if set true.
ENABLE_PUBLIC_SERVICE=false
ENABLE_PAID_SUBSCRIPTIONS=false
ENABLE_PURCHASE_REDIRECT=false
ENABLE_THIRD_PARTY_FUNDS=false
ENABLE_LIVE_TRADING=false
ENABLE_ORDER_ENTRY=false

# Real providers are disabled until registry rights are approved. Never commit real keys.
TWELVE_DATA_ENABLED=false
TWELVE_DATA_API_KEY=
GDELT_ENABLED=false

# Optional delivery channels; in-app alerts work without them.
EMAIL_ALERTS_ENABLED=false
WEBHOOK_ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=

# Remote production listening is blocked in this MVP even if this placeholder is true;
# real SSO/MFA/RBAC middleware must be implemented and verified in a later phase.
AUTH_ENABLED=false
# Reserved for the checked Docker Compose localhost port mapping; do not enable on a host run.
CONTAINER_LOCALHOST_BOUND=false
LOG_LEVEL=INFO
